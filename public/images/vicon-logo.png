<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="VICON Studios builds worlds through branding, motion, photography, creative direction and digital storytelling." />
  <meta name="theme-color" content="#AEE8FF" />
  <meta property="og:title" content="VICON Studios — Jump In Our World" />
  <meta property="og:description" content="We build worlds through branding, motion, photography and digital storytelling." />
  <meta property="og:image" content="public/images/vicon-editorial.webp" />
  <title>VICON Studios — Jump In Our World</title>
  <link rel="icon" href="public/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <div class="noise" aria-hidden="true"></div>
  <div class="cursor" aria-hidden="true"><span>VIEW</span></div>

  <div class="loader" id="loader" aria-label="Opening the VICON Universe">
    <div class="loader-logo" aria-hidden="true">
      <img class="loader-brandmark" src="public/images/vicon-logo.png" alt="" />
    </div>
    <div class="loader-meta"><span>Opening the VICON Universe…</span><strong id="loaderCount">00</strong></div>
  </div>

  <header class="site-nav-wrap">
    <nav class="site-nav" aria-label="Primary navigation">
      <a class="brand magnetic" href="#top" aria-label="VICON Studios home">
        <img class="brand-logo" src="public/images/vicon-logo.png" alt="VICON Studios" />
      </a>
      <div class="nav-links">
        <a href="#worlds">Worlds</a><a href="#projects">Projects</a><a href="#about">About</a><a href="#process">Process</a><a href="#contact">Contact</a>
      </div>
      <a class="nav-cta magnetic" href="#contact">Let's talk <span>↗</span></a>
      <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false"><span></span><span></span></button>
    </nav>
    <div class="mobile-menu" aria-hidden="true">
      <a href="#worlds">Worlds</a><a href="#projects">Projects</a><a href="#about">About</a><a href="#process">Process</a><a href="#contact">Contact</a>
    </div>
  </header>

  <main>
    <section class="hero" id="top" aria-labelledby="hero-title">
      <svg class="hero-doodle star star-one parallax" data-speed="0.05" viewBox="0 0 100 100" aria-hidden="true"><path d="M50 2 59 39 98 50 59 61 50 98 41 61 2 50 41 39Z" fill="#FFD800" stroke="#111" stroke-width="4"/></svg>
      <svg class="hero-doodle planet parallax" data-speed="-0.08" viewBox="0 0 160 120" aria-hidden="true"><circle cx="80" cy="62" r="38" fill="#F7A3C5" stroke="#111" stroke-width="4"/><ellipse cx="80" cy="62" rx="72" ry="18" fill="none" stroke="#111" stroke-width="5" transform="rotate(-12 80 62)"/><circle cx="67" cy="49" r="5" fill="#111"/></svg>
      <svg class="hero-doodle plane parallax" data-speed="0.11" viewBox="0 0 150 100" aria-hidden="true"><path d="M7 47 140 8 87 89 63 58 7 47Z" fill="#F8F7F3" stroke="#111" stroke-width="4" stroke-linejoin="round"/><path d="m63 58 77-50-54 43" fill="none" stroke="#111" stroke-width="4"/></svg>
      <div class="orbit-dots" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

      <div class="hero-grid container">
        <div class="hero-copy">
          <div class="eyebrow reveal"><span>Independent creative studio</span><span>Lusaka · Worldwide</span></div>
          <h1 id="hero-title"><span class="line"><span>Jump in</span></span><span class="line line-shift"><span>our world</span></span></h1>
          <div class="hero-bottom reveal">
            <p>We build worlds of creativity through branding, motion design, photography and visual storytelling.</p>
            <div class="hero-actions">
              <a class="button button-black magnetic" href="#worlds">Explore worlds <span>↓</span></a>
              <a class="text-link magnetic" href="#contact">Start your project <span>↗</span></a>
            </div>
          </div>
        </div>

        <div class="hero-visual parallax" data-speed="-0.045">
          <div class="magazine-shadow"></div>
          <figure class="magazine" data-cursor="VIEW" aria-label="Rotating VICON art archive">
            <div class="magazine-art" id="magazineArt">
              <img class="magazine-slide active" src="public/images/vicon-editorial.webp" alt="VICON Studios editorial magazine cover" data-edition="VICON Edition 01" data-caption="World-building journal" />
              <img class="magazine-slide" src="public/images/vicon-crt.webp" alt="Vintage VICON television transmitting the studio identity" data-edition="VICON Transmission 02" data-caption="Signal from our world" />
              <img class="magazine-slide" src="public/images/vicon-neon-mark.webp" alt="Electric teal sculptural VICON symbol" data-edition="VICON Object 03" data-caption="Motion experiment" />
              <img class="magazine-slide" src="public/images/vicon-portal.webp" alt="Figure entering an illuminated VICON portal" data-edition="VICON Portal 04" data-caption="Step into the unknown" />
            </div>
            <figcaption><span id="magazineEdition">VICON Edition 01</span><span id="magazineCaption">World-building journal</span></figcaption>
            <div class="magazine-dots" aria-hidden="true"><i class="active"></i><i></i><i></i><i></i></div>
          </figure>
          <span class="sticker sticker-new">NEW<br>WORLD!</span>
          <span class="sticker sticker-smile" aria-hidden="true">☺</span>
          <svg class="scribble" viewBox="0 0 220 95" aria-hidden="true"><path d="M5 72c39-56 67 28 105-11 26-27 49-23 103-50M180 4l34 7-9 32" fill="none" stroke="#111" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      </div>
      <div class="scroll-note"><span>Scroll to enter</span><i></i></div>
    </section>

    <div class="marquee" aria-label="VICON Studios creative motto">
      <div class="marquee-track">
        <span>Jump in our world <b>✦</b> Build worlds of creativity <b>✦</b> VICON Studios <b>✦</b></span>
        <span aria-hidden="true">Jump in our world <b>✦</b> Build worlds of creativity <b>✦</b> VICON Studios <b>✦</b></span>
      </div>
    </div>

    <section class="manifesto" id="about" aria-labelledby="manifesto-title">
      <div class="container">
        <div class="section-top reveal"><span class="section-index">01</span><span>Our philosophy</span><span>Make it memorable</span></div>
        <h2 id="manifesto-title" class="display reveal-lines">We don't follow trends.<br><em>We build worlds.</em></h2>
        <p class="manifesto-intro reveal">One studio. Many dimensions. We mix strategy, image, movement and sound to create ideas with their own gravity.</p>

        <div class="object-stage" aria-label="A playful collection of creative tools">
          <figure class="creative-object object-tv object-photo parallax" data-speed="0.035">
            <img src="public/images/vicon-crt.webp" alt="Weathered vintage television displaying the VICON identity" />
            <figcaption><span>LIVE TRANSMISSION</span><b>VICON.TV / 001</b></figcaption>
          </figure>
          <svg class="creative-object object-camera parallax" data-speed="-0.055" viewBox="0 0 260 180" aria-hidden="true">
            <path d="M26 57h47l14-23h78l16 23h50c11 0 20 9 20 20v72c0 11-9 20-20 20H26c-11 0-20-9-20-20V77c0-11 9-20 20-20Z" fill="#13D8C4" stroke="#111" stroke-width="7"/><circle cx="132" cy="112" r="45" fill="#F8F7F3" stroke="#111" stroke-width="7"/><circle cx="132" cy="112" r="26" fill="#111"/><circle cx="140" cy="104" r="7" fill="#AEE8FF"/><rect x="28" y="29" width="36" height="28" rx="6" fill="#FFD800" stroke="#111" stroke-width="6"/>
          </svg>
          <svg class="creative-object object-spray parallax" data-speed="0.075" viewBox="0 0 150 260" aria-hidden="true">
            <path d="M46 28h61v36H46z" fill="#111"/><path d="M36 61h81l14 32v145H21V93Z" fill="#F7A3C5" stroke="#111" stroke-width="7" stroke-linejoin="round"/><path d="M22 121h108v68H22z" fill="#F8F7F3" stroke="#111" stroke-width="6"/><path d="m42 174 27-42 15 27 12-17 16 32Z" fill="#FFD800" stroke="#111" stroke-width="4"/><path d="M71 15h51" stroke="#111" stroke-width="8" stroke-linecap="round"/><circle cx="132" cy="15" r="8" fill="#111"/><path d="M139 13c10-4 20-4 29 0" stroke="#111" stroke-width="4" stroke-dasharray="4 7"/>
          </svg>
          <svg class="creative-object object-slate parallax" data-speed="-0.025" viewBox="0 0 270 210" aria-hidden="true">
            <path d="M19 61h236v135H19z" fill="#111" stroke="#111" stroke-width="7"/><path d="M20 20h235v49H20z" fill="#F8F7F3" stroke="#111" stroke-width="7" transform="rotate(-5 20 20)"/><path d="m45 20 31 43m33-49 31 43m34-49 31 43" stroke="#111" stroke-width="7"/><path d="M45 101h183M45 135h93M45 169h144" stroke="#F8F7F3" stroke-width="7"/>
          </svg>
          <svg class="creative-object object-disco parallax" data-speed="0.06" viewBox="0 0 230 230" aria-hidden="true">
            <defs><clipPath id="ballClip"><circle cx="115" cy="115" r="88"/></clipPath></defs><circle cx="115" cy="115" r="91" fill="#F8F7F3" stroke="#111" stroke-width="7"/>
            <g clip-path="url(#ballClip)" stroke="#111" stroke-width="3"><path d="M27 80h176M22 115h186M30 150h170M58 45h114M58 185h114M80 25c-31 56-30 124 0 180M115 22v187M150 25c31 56 30 124 0 180" fill="none"/><path d="M22 115h93V22H22Z" fill="#AEE8FF" opacity=".7"/><path d="M115 115h93v93h-93Z" fill="#F7A3C5" opacity=".7"/></g><path d="M115 0v25" stroke="#111" stroke-width="7"/>
          </svg>
          <svg class="creative-object object-book parallax" data-speed="-0.08" viewBox="0 0 270 210" aria-hidden="true">
            <path d="M20 34 127 16c13-2 25 7 27 20l20 137-107 18c-13 2-25-7-27-20Z" fill="#F8F7F3" stroke="#111" stroke-width="7"/><path d="m154 36 90 10-16 142-101-11 16-134c1-5 5-8 11-7Z" fill="#AEE8FF" stroke="#111" stroke-width="7"/><path d="M74 73h57m-51 30 55-9m-49 38 52-9" stroke="#111" stroke-width="6"/><path d="M165 75c33-25 55 4 31 28-23 22-44-6-13-19" fill="none" stroke="#F7A3C5" stroke-width="9" stroke-linecap="round"/>
          </svg>
          <div class="stage-note note-one">Ideas with<br><strong>gravity.</strong></div>
          <div class="stage-note note-two">No beige<br>thinking →</div>
          <figure class="reference-cutout parallax" data-speed="0.025">
            <img src="public/images/editorial-reference.webp" alt="Creative studio moodboard reference" />
            <figcaption>INSPIRATION / 025</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="worlds" id="worlds" aria-labelledby="worlds-title">
      <div class="container">
        <div class="section-top reveal"><span class="section-index">02</span><span>Capabilities</span><span>Pick a portal</span></div>
        <div class="worlds-heading">
          <h2 id="worlds-title" class="display reveal-lines">Explore our<br><em>worlds.</em></h2>
          <p class="reveal">Five connected disciplines. One creative universe. Enter anywhere—leave with something iconic.</p>
        </div>

        <div class="world-grid">
          <button class="world-card world-brand tilt-card" type="button" data-world="brand" data-cursor="ENTER">
            <span class="world-number">01 / 05</span><span class="world-arrow">↗</span>
            <svg class="world-icon" viewBox="0 0 250 190" aria-hidden="true"><path d="M44 31h121v121H44z" fill="#F8F7F3" stroke="#111" stroke-width="7"/><circle cx="164" cy="99" r="61" fill="#F7A3C5" stroke="#111" stroke-width="7"/><path d="M94 42v104m-52-52h105" stroke="#111" stroke-width="7"/><path d="m161 55 14 30 32 5-23 23 6 32-29-15-29 15 6-32-23-23 32-5Z" fill="#FFD800" stroke="#111" stroke-width="5"/></svg>
            <span class="world-copy"><strong>Brand World</strong><small>Identity, strategy and visual systems</small></span>
          </button>

          <button class="world-card world-motion tilt-card" type="button" data-world="motion" data-cursor="ENTER">
            <span class="world-number">02 / 05</span><span class="world-arrow">↗</span>

            <div class="world-icon world-icon-image motion-signal" aria-hidden="true">
              <img src="public/images/vicon-neon-mark.webp" alt="" />
              <span class="icon-orbit orbit-one"></span><span class="icon-orbit orbit-two"></span>
              <b>KINETIC<br>SIGNAL</b>
            </div>
            <span class="world-copy"><strong>Motion World</strong><small>Animation, reels and title sequences</small></span>
          </button>

          <button class="world-card world-visual tilt-card" type="button" data-world="visual" data-cursor="ENTER">
            <span class="world-number">03 / 05</span><span class="world-arrow">↗</span>

            <div class="world-icon world-icon-image visual-portal" aria-hidden="true">
              <img src="public/images/vicon-portal.webp" alt="" />
              <span class="icon-corner corner-one"></span><span class="icon-corner corner-two"></span>
              <b>LOOK<br>BEYOND</b>
            </div>
            <span class="world-copy"><strong>Visual World</strong><small>Photography and art direction</small></span>
          </button>

          <button class="world-card world-campaign tilt-card" type="button" data-world="campaign" data-cursor="ENTER">
            <span class="world-number">04 / 05</span><span class="world-arrow">↗</span>
            <svg class="world-icon" viewBox="0 0 250 190" aria-hidden="true"><path d="m29 74 137-45v132L29 117Z" fill="#F8F7F3" stroke="#111" stroke-width="7"/><path d="m167 62 52-16v98l-52-18Z" fill="#FFD800" stroke="#111" stroke-width="7"/><path d="M52 120 71 168h47l-19-38" fill="#F7A3C5" stroke="#111" stroke-width="7"/><path d="m194 30 20-23m-20 152 22 22M221 94h27" stroke="#111" stroke-width="7"/></svg>
            <span class="world-copy"><strong>Campaign World</strong><small>Creative launches and advertising</small></span>
          </button>

          <button class="world-card world-music tilt-card" type="button" data-world="music" data-cursor="ENTER">
            <span class="world-number">05 / 05</span><span class="world-arrow">↗</span>
            <svg class="world-icon" viewBox="0 0 250 190" aria-hidden="true"><circle cx="125" cy="95" r="77" fill="#111"/><circle cx="125" cy="95" r="32" fill="#AEE8FF"/><circle cx="125" cy="95" r="10" fill="#111"/><path d="M125 18v46m0 62v46M48 95h46m62 0h46M71 41l32 32m44 44 32 32M179 41l-32 32m-44 44-32 32" stroke="#F8F7F3" stroke-width="5"/><path d="M204 17v91c0 17-21 28-35 18-14-10-4-31 14-31h21" fill="#FFD800" stroke="#111" stroke-width="7"/></svg>
            <span class="world-copy"><strong>Music World</strong><small>Album covers, visuals and live experiences</small></span>
          </button>
        </div>
      </div>
    </section>

    <section class="featured" id="projects" aria-labelledby="projects-title">
      <div class="featured-sticky">
        <div class="projects-head container">
          <div class="section-top on-dark"><span class="section-index">03</span><span>Selected work</span><span>2022—2026</span></div>
          <div class="projects-title-row"><h2 id="projects-title" class="display">Featured<br><em>projects.</em></h2><div class="project-progress"><span>Scroll to travel</span><div><i id="projectProgress"></i></div></div></div>
        </div>
        <div class="project-track" id="projectTrack">
          <article class="project-card" data-project="voltora" data-cursor="OPEN">
            <div class="project-image"><img src="public/images/voltora.webp" alt="Voltora Universe campaign featuring an electric teal object orbiting a planet" /><span class="project-tag">Brand universe / Motion</span></div>
            <div class="project-info"><div><span>01</span><h3>Voltora<br>Universe</h3></div><p>Launching energy beyond the bottle.</p><button type="button" aria-label="Open Voltora Universe case study">↗</button></div>
          </article>
          <article class="project-card" data-project="urban" data-cursor="OPEN">
            <div class="project-image"><img src="public/images/urban-culture.webp" alt="Urban Culture fashion campaign photographed in Lusaka" /><span class="project-tag">Photography / Campaign</span></div>
            <div class="project-info"><div><span>02</span><h3>Urban<br>Culture</h3></div><p>A city moving at its own frequency.</p><button type="button" aria-label="Open Urban Culture case study">↗</button></div>
          </article>
          <article class="project-card" data-project="galaxy" data-cursor="OPEN">
            <div class="project-image"><img src="public/images/galaxy-visuals.webp" alt="Galaxy Visuals surreal chrome forms on a pink landscape" /><span class="project-tag">CGI / Visual identity</span></div>
            <div class="project-info"><div><span>03</span><h3>Galaxy<br>Visuals</h3></div><p>A new dimension for digital expression.</p><button type="button" aria-label="Open Galaxy Visuals case study">↗</button></div>
          </article>
          <article class="project-card project-graphic" data-project="kicks" data-cursor="OPEN">
            <div class="project-image kicks-art" aria-label="Kicks Lab graphic identity artwork"><div class="kicks-type">KICKS<br>LAB</div><div class="shoe-shape"></div><div class="kicks-code">DROP_004 / LSK</div><span class="project-tag">Identity / Digital</span></div>
            <div class="project-info"><div><span>04</span><h3>Kicks<br>Lab</h3></div><p>Streetwear drops engineered for desire.</p><button type="button" aria-label="Open Kicks Lab case study">↗</button></div>
          </article>
          <article class="project-card" data-project="zed" data-cursor="OPEN">
            <div class="project-image"><img src="public/images/vicon-editorial.webp" alt="VICON editorial artwork used in the Zed Hype campaign" /><span class="project-tag">Campaign / Editorial</span></div>
            <div class="project-info"><div><span>05</span><h3>Zed Hype<br>Campaign</h3></div><p>Turning local energy into a movement.</p><button type="button" aria-label="Open Zed Hype Campaign case study">↗</button></div>
          </article>
          <div class="project-end"><span>Like what<br>you see?</span><a href="#contact" class="button button-yellow magnetic">Start a project ↗</a></div>
        </div>
      </div>
    </section>

    <section class="portal-section" id="process" aria-labelledby="process-title">
      <div class="container">
        <div class="section-top reveal"><span class="section-index">04</span><span>How we create</span><span>Simple. Collaborative. Alive.</span></div>
        <div class="process-heading"><h2 id="process-title" class="display reveal-lines">Enter the<br><em>portal.</em></h2><p class="reveal">No rigid agency theatre. Just four focused jumps from the spark to the world.</p></div>

        <div class="portal-map">
          <svg class="path-map" viewBox="0 0 1200 660" preserveAspectRatio="none" aria-hidden="true"><path d="M90 390C230 80 340 86 445 280s223 207 325 30 220-167 346 30" fill="none" stroke="#111" stroke-width="4" stroke-dasharray="10 14"/></svg>
          <article class="portal portal-one reveal" data-step="01">
            <span class="portal-no">01</span><div class="portal-ring"><div><span>JUMP</span></div></div><h3>Jump In</h3><p>Discover the vision.</p>
          </article>
          <article class="portal portal-two reveal" data-step="02">
            <span class="portal-no">02</span><div class="portal-ring"><div><span>BUILD</span></div></div><h3>Build</h3><p>Strategy and creative direction.</p>
          </article>
          <article class="portal portal-three reveal" data-step="03">
            <span class="portal-no">03</span><div class="portal-ring"><div><span>MAKE</span></div></div><h3>Create</h3><p>Design, animation and production.</p>
          </article>
          <article class="portal portal-four reveal" data-step="04">
            <span class="portal-no">04</span><div class="portal-ring"><div><span>LIVE</span></div></div><h3>Launch</h3><p>The world goes live.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="testimonials" aria-labelledby="testimonials-title">
      <div class="container">
        <div class="section-top reveal"><span class="section-index">05</span><span>Transmission received</span><span>Kind words</span></div>
        <h2 id="testimonials-title" class="display reveal-lines">People like<br><em>our world.</em></h2>
        <div class="quote-grid">
          <figure class="quote quote-one reveal"><blockquote>“VICON didn't just refresh the brand—they gave it a pulse, a personality and a place in culture.”</blockquote><figcaption><strong>Karabo Molefe</strong><span>Brand Director, Voltora</span></figcaption><span class="quote-mark">“</span></figure>
          <figure class="quote quote-two reveal"><blockquote>“They found the thing we were trying to say before we had the words for it.”</blockquote><figcaption><strong>Amara Ndlovu</strong><span>Founder, Kicks Lab</span></figcaption><span class="quote-smile">☺</span></figure>
          <figure class="quote quote-three reveal"><blockquote>“Brave ideas, beautiful craft, and zero ego. The whole experience felt electric.”</blockquote><figcaption><strong>Tawanda Phiri</strong><span>Creative Lead, Zed Hype</span></figcaption><span class="quote-spark">✦</span></figure>
        </div>
      </div>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <div class="container contact-grid">
        <div class="contact-copy">
          <div class="section-top reveal"><span class="section-index">06</span><span>New business</span><span>Say hello</span></div>
          <h2 id="contact-title" class="display reveal-lines">Ready to<br><em>jump in?</em></h2>
          <p class="reveal">Let's create something iconic together.</p>
         <a class="contact-email magnetic" href="mailto:viconstudios@gmail.com">viconstudios@gmail.com <span>↗</span></a>
        </div>
        <form class="contact-form" id="contactForm">
          <label><span>Name</span><input type="text" name="name" placeholder="Your name" required /></label>
          <label><span>Email</span><input type="email" name="email" placeholder="you@company.com" required /></label>
          <label><span>Company</span><input type="text" name="company" placeholder="Company / brand" /></label>

          <label class="full"><span>Project description</span><textarea name="message" rows="3" placeholder="Tell us what world you want to build…" required></textarea></label>
          <button class="button button-black send-button magnetic" type="submit"><span>Send message</span><b>↗</b></button>
          <p class="form-status" id="formStatus" role="status"></p>
        </form>
        <div class="mascot-wrap reveal" aria-label="VICON mascot waving and saying Jump In Our World">
          <div class="mascot-bubble">“Jump In<br>Our World.”</div>
          <svg class="mascot" viewBox="0 0 310 330" aria-hidden="true">
            <path d="M98 96c0-54 38-81 91-74 48 7 70 45 61 96-8 46-42 75-90 69-47-6-66-44-62-91Z" fill="#FFD800" stroke="#111" stroke-width="8"/>
            <circle cx="141" cy="95" r="8" fill="#111"/><circle cx="202" cy="95" r="8" fill="#111"/><path d="M139 130c20 23 44 22 63-2" fill="none" stroke="#111" stroke-width="8" stroke-linecap="round"/>
            <path d="M116 176c-21 24-32 56-31 107h155c1-43-7-75-30-101" fill="#F7A3C5" stroke="#111" stroke-width="8"/><path d="M109 201 35 163c-15-8-29 11-17 23l73 73" fill="#F7A3C5" stroke="#111" stroke-width="8" stroke-linecap="round"/><path d="m31 163-6-29m15 34 21-24m-29 19-27 2" fill="none" stroke="#111" stroke-width="8" stroke-linecap="round"/><path d="M141 202h39v81h-39z" fill="#AEE8FF" stroke="#111" stroke-width="7"/><path d="M91 282v38m149-38v38" stroke="#111" stroke-width="9"/>
          </svg>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
